# ==========================================
# RIPPLEGUARD ENVIRONMENT CONFIGURATION
# ==========================================

# Frontend: Remote FastAPI Backend URL
# Leave empty if using local Vite dev proxy or single-server deployment.
# Set to your deployed backend URL when frontend is hosted separately (e.g., on Vercel/Netlify).
# Example: VITE_API_BASE_URL=https://rippleguard-backend.onrender.com
VITE_API_BASE_URL=

# Backend: HTTP Server Port (Default: 8000)
PORT=8000

# Backend: Allowed CORS Origins (Comma-separated, or * for all)
# Example: CORS_ORIGINS=https://rippleguard.vercel.app,http://localhost:5173
CORS_ORIGINS=*
